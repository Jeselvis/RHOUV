# Copy to .env and fill in your keys. Never commit .env.

# Anthropic direct
# ANTHROPIC_API_KEY=

# Gemini direct — model strings: "gemini/gemini-2.5-flash-lite" etc.
# GEMINI_API_KEY=

# OpenAI-compatible (Magica AI or similar)
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://inference.magica.com/v1

# Model assignments — override defaults without touching code.
# Magica model strings: "openai/deepseek/deepseek-v4.1-flash", "openai/~anthropic/claude-haiku-latest", etc.
# MODEL_PERSONALITY=openai/deepseek/deepseek-v4.1-flash
# MODEL_DIRECTOR=openai/deepseek/deepseek-v4.1-flash
# MODEL_JUDGE=openai/~anthropic/claude-haiku-latest
